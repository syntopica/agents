{
  "servers": {
    "context7": {
      "targets": ["claude-personal", "claude-secondary", "codex"],
      "transport": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": {
          "from_env": "CONTEXT7_API_KEY"
        }
      }
    },
    "codegraph": {
      "targets": ["claude-personal", "claude-secondary", "codex"],
      "transport": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    }
  }
}
