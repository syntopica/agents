{
  "version": 1,
  "connectors": [
    {
      "id": "codegraph",
      "match": "codegraph",
      "profiles": ["claude-personal", "claude-secondary", "codex"],
      "ownership": "machine",
      "probe": "native-cli",
      "criticality": "required"
    },
    {
      "id": "memstore",
      "match": "memstore",
      "profiles": ["codex"],
      "ownership": "machine",
      "probe": "native-cli",
      "criticality": "required"
    },
    {
      "id": "cloudflare",
      "match": "plugin:cloudflare:",
      "profiles": ["claude-personal", "claude-secondary"],
      "ownership": "account",
      "probe": "claude-cli-prefix",
      "criticality": "required"
    },
    {
      "id": "gateway-example",
      "match": "gateway-example",
      "profiles": ["claude-personal"],
      "ownership": "account",
      "probe": "native-cli",
      "criticality": "required",
      "boundary": "access-gateway"
    }
  ]
}
